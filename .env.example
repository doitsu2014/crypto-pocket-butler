# Non-secret configuration only. Never put a credential, token, key, or connection
# string in this file. Secrets arrive from Supabase Vault / Docker secrets through
# the *_FILE paths below.
RUST_LOG=info

# API Gateway
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_ANONYMOUS_RATE_LIMIT_PER_MINUTE=30
ASSET_REGISTRY_URL=http://asset-registry:8081
IDENTITY_URL=http://identity-api:8083
UPSTREAM_TIMEOUT_MS=2000

# Asset Registry
ASSET_REGISTRY_PORT=8081

# Audit API
AUDIT_PORT=8084
AUDIT_APPENDS_PER_MINUTE=1000
AUDIT_QUERIES_PER_MINUTE=30
AUDIT_EXPORTS_PER_HOUR=5

# Audit retention worker
AUDIT_SWEEP_INTERVAL_SECONDS=3600
AUDIT_RETENTION_BATCH_SIZE=10000
AUDIT_RETENTION_MAX_BATCHES=1000
AUDIT_RETENTION_PAUSE_MS=200
AUDIT_PARTITION_HORIZON_MONTHS=3
AUDIT_DELETION_BATCH=20

# Account API and sync worker
ACCOUNT_PORT=8091
ACCOUNT_WORKER_PORT=8092
ACCOUNT_WORKER_URL=http://account-worker:8092
ACCOUNT_API_POOL=12
ACCOUNT_WORKER_POOL=8
ACCOUNT_SYNC_INTERVAL_SECONDS=60
ACCOUNT_VERIFY_INTERVAL_SECONDS=21600
ACCOUNT_TOKEN_SERVICE=account
ACCOUNT_IMPORT_MAX_BYTES=10485760
IDENTITY_URL=http://identity-api:8083
ASSET_REGISTRY_URL=http://asset-registry:8081
NOTIFICATION_URL=http://notification-api:8099
EVM_RPC_URL=https://<evm-rpc-endpoint>
SOLANA_RPC_URL=https://<solana-rpc-endpoint>

# Identity API and privacy worker
IDENTITY_PORT=8083
IDENTITY_WORKER_PORT=8085
IDENTITY_WORKER_URL=http://identity-worker:8085
IDENTITY_EXPORT_BUCKET=identity-exports
IDENTITY_API_POOL=12
IDENTITY_WORKER_POOL=8
IDENTITY_SWEEP_INTERVAL_SECONDS=60
IDENTITY_TOKEN_SERVICE=identity
AUDIT_URL=http://audit-api:8084
ACCOUNT_URL=http://account:8091
LEDGER_URL=http://ledger:8092
PORTFOLIO_URL=http://portfolio:8101

# Supabase Auth and Storage (public endpoints, not secrets)
JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
SUPABASE_AUTH_URL=https://<project-ref>.supabase.co/auth/v1
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1

# Support console (build-time values baked into the static bundle at /support).
# These are public endpoints, never secrets. The anon key is the Supabase
# public key; the service-role key is never used by a browser bundle.
VITE_GATEWAY_URL=/v1
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>

# Secret file paths (the secret itself lives in Vault or a Docker secret).
# Each service reads the same variable name from its own environment:
#   asset-registry: DATABASE_URL_FILE=/run/secrets/registry_database_url
#   audit-api:      DATABASE_URL_FILE=/run/secrets/audit_app_dsn
#   audit-retention DATABASE_URL_FILE=/run/secrets/audit_retention_dsn
DATABASE_URL_FILE=/run/secrets/registry_database_url
# DATABASE_URL_FILE=/run/secrets/audit_app_dsn
# DATABASE_URL_FILE=/run/secrets/audit_retention_dsn
# DATABASE_URL_FILE=/run/secrets/identity_database_url
# DATABASE_URL_FILE=/run/secrets/account_database_url
# DATABASE_URL_FILE=/run/secrets/account_migrate_database_url
SERVICE_TOKENS_FILE=/run/secrets/audit_service_tokens
# The identity_service_tokens JSON map must carry a "notification" entry whose
# token equals notification_outbound_token (C3 contact); any other caller is 403.
# SERVICE_TOKENS_FILE=/run/secrets/identity_service_tokens
# SERVICE_TOKENS_FILE=/run/secrets/account_service_tokens
# SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/identity_supabase_service_role
# SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/account_supabase_service_role
# GATE_TOKEN_KEY_FILE=/run/secrets/identity_gate_token_key

# Analytics API and worker
ANALYTICS_PORT=8095
ANALYTICS_WORKER_PORT=8096
ANALYTICS_API_POOL=10
ANALYTICS_WORKER_POOL=6
IDENTITY_URL=http://identity-api:8083
AUDIT_URL=http://audit-api:8084
# DATABASE_URL_FILE=/run/secrets/analytics_database_url
# DATABASE_URL_FILE=/run/secrets/analytics_migrate_database_url
# OUTBOUND_TOKEN_FILE=/run/secrets/analytics_outbound_token
# SMOKE_TOKEN_FILE=/run/secrets/analytics_smoke_token

# Market Data API and refresh worker
MARKET_DATA_PORT=8093
MARKET_DATA_WORKER_PORT=8094
MARKET_DATA_API_POOL=12
MARKET_DATA_WORKER_POOL=8
MARKET_DATA_SWEEP_INTERVAL_SECONDS=60
MARKET_DATA_TOKEN_SERVICE=market-data
MARKET_DATA_FX_BASE_CURRENCIES=EUR,GBP,VND,USDT
MARKET_DATA_PROVIDER_URLS=binance=https://api.binance.com,coingecko=https://api.coingecko.com
# DATABASE_URL_FILE=/run/secrets/market_data_database_url
# The outbound service token and the C11 run token are read from Supabase Vault
# through read_provider_secret('outbound') and read_provider_secret('run');
# provider keys use read_provider_secret('<source>'). No token file is mounted.

# Ledger API, worker, and migration job
LEDGER_PORT=8097
LEDGER_WORKER_PORT=8098
LEDGER_API_POOL=12
LEDGER_WORKER_POOL=8
ACCOUNT_URL=http://account-api:8091
ASSET_REGISTRY_URL=http://asset-registry:8081
MARKET_DATA_URL=http://market-data-api:8093
LEDGER_BASE_CURRENCY=USD
AUDIT_URL=http://audit-api:8084
# DATABASE_URL_FILE=/run/secrets/ledger_database_url
# DATABASE_URL_FILE=/run/secrets/ledger_migrate_database_url
# ANONYMISER_DATABASE_URL_FILE=/run/secrets/ledger_anonymiser_database_url
# OUTBOUND_TOKEN_FILE=/run/secrets/ledger_outbound_token
# SMOKE_TOKEN_FILE=/run/secrets/ledger_smoke_token

# Portfolio API, valuation worker, and migration job
PORTFOLIO_PORT=8101
PORTFOLIO_WORKER_PORT=8102
PORTFOLIO_API_POOL=12
PORTFOLIO_WORKER_POOL=8
PORTFOLIO_RUN_INTERVAL_SECONDS=3600
PORTFOLIO_TOKEN_SERVICE=portfolio
PORTFOLIO_WORKER_URL=http://portfolio-worker:8102
ACCOUNT_URL=http://account-api:8091
MARKET_DATA_URL=http://market-data-api:8093
LEDGER_URL=http://ledger-api:8097
IDENTITY_URL=http://identity-api:8089
AUDIT_URL=http://audit-api:8084
# DATABASE_URL_FILE=/run/secrets/portfolio_database_url
# DATABASE_URL_FILE=/run/secrets/portfolio_migrate_database_url
# OUTBOUND_TOKEN_FILE=/run/secrets/portfolio_outbound_token
# The release job holds the smoke token; the service never mounts it:
# SMOKE_TOKEN_FILE=/run/secrets/portfolio_smoke_token

# Notification API, delivery worker, and migration job
NOTIFICATION_PORT=8099
NOTIFICATION_WORKER_PORT=8100
NOTIFICATION_API_POOL=10
NOTIFICATION_WORKER_POOL=8
IDENTITY_URL=http://identity-api:8083
AUDIT_URL=http://audit-api:8084
EMAIL_PROVIDER_URL=https://<email-provider-endpoint>
EMAIL_FROM=notifications@cryptopocketbutler.example
# DATABASE_URL_FILE=/run/secrets/notification_database_url
# DATABASE_URL_FILE=/run/secrets/notification_migrate_database_url
# Must be the "notification" entry of identity_service_tokens (C3 contact).
# OUTBOUND_TOKEN_FILE=/run/secrets/notification_outbound_token
# SMOKE_TOKEN_FILE=/run/secrets/notification_smoke_token
# EMAIL_KEY_FILE=/run/secrets/notification_email_key
