# Job Orchestration migrate/prune image.
#
#   docker build -f services/job-orchestration/Dockerfile.migrate -t cpb/job-orchestration-migrate .
FROM rust:1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd AS builder
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY services ./services
RUN cargo build --release --locked -p job-orchestration --bin job-orchestration-migrate

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10007 --create-home --shell /usr/sbin/nologin app
COPY --from=builder /app/target/release/job-orchestration-migrate /usr/local/bin/job-orchestration-migrate
USER 10007
ENTRYPOINT ["/usr/local/bin/job-orchestration-migrate"]
