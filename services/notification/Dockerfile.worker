# Notification worker image: the leased delivery poller, C11 delivery and
# retention run paths, and probes.
#
# Build from the repository root:
#   docker build -f services/notification/Dockerfile.worker -t cpb/notification-worker .
#
# The container runs non-root with no published port; Job Orchestration and the
# gateway reach it over `internal`.
FROM rust:1-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY services ./services
RUN cargo build --release --locked -p notification --bin notification-worker

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin app

COPY --from=builder /app/target/release/notification-worker /usr/local/bin/notification-worker

USER 10001
EXPOSE 8100
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8100/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/notification-worker"]
