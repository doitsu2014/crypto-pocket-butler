# Local values, generated by scripts/init-env.sh into .env.
# This file documents the static shape only; it contains no secret.

# Supabase endpoints (host-side). The database is on 54322, the API gateway on
# 54321, Studio on 54323 and Mailpit on 54324 - the same ports the Supabase CLI
# uses locally, so tooling memory carries over.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321
SUPABASE_JWT_AUDIENCE=authenticated

# The SPA is served on this port.
SPA_URL=http://localhost:8080

# Generated by init-env.sh (never commit real values):
#   POSTGRES_PASSWORD, LOCAL_DB_PASSWORD
#   SUPABASE_JWT_SECRET, GOTRUE_JWT_KEYS, SUPABASE_PUBLIC_JWKS
#   SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   IDENTITY_GATE_TOKEN_KEY, NOTIFICATION_EMAIL_KEY, STUDIO_PG_META_CRYPTO_KEY
#   ADMIN_EMAIL, ADMIN_PASSWORD
#   EVM_RPC_URL, SOLANA_RPC_URL
