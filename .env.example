# Non-secret configuration only. Never put a credential, token, key, or connection
# string in this file. Secrets arrive from Supabase Vault / Docker secrets through
# the *_FILE paths below.
RUST_LOG=info

# API Gateway
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_ANONYMOUS_RATE_LIMIT_PER_MINUTE=30
ASSET_REGISTRY_URL=http://asset-registry:8081
UPSTREAM_TIMEOUT_MS=2000

# Asset Registry
ASSET_REGISTRY_PORT=8081

# Audit API
AUDIT_PORT=8084
AUDIT_APPENDS_PER_MINUTE=1000
AUDIT_QUERIES_PER_MINUTE=30
AUDIT_EXPORTS_PER_HOUR=5

# Audit retention worker
AUDIT_SWEEP_INTERVAL_SECONDS=3600
AUDIT_RETENTION_BATCH_SIZE=10000
AUDIT_RETENTION_MAX_BATCHES=1000
AUDIT_RETENTION_PAUSE_MS=200
AUDIT_PARTITION_HORIZON_MONTHS=3
AUDIT_DELETION_BATCH=20

# Supabase Auth (public endpoints, not secrets)
JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated

# Secret file paths (the secret itself lives in Vault or a Docker secret)
DATABASE_URL_FILE=/run/secrets/registry_database_url
SERVICE_TOKENS_FILE=/run/secrets/audit_service_tokens
