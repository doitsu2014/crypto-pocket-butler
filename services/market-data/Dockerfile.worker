# Market Data refresh-worker image.
#
# Build from the repository root:
#   docker build -f services/market-data/Dockerfile.worker -t cpb/market-data-worker .
#
# The worker runs the lease sweep and retention supervisor and exposes its probes
# on 8094. It runs non-root with a read-only root filesystem.
# Both bases are digest-pinned (NFR12.1). Refresh a digest deliberately.
FROM rust:1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd AS builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY services ./services
RUN cargo build --release --locked -p market-data --bin market-data-worker

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10005 --create-home --shell /usr/sbin/nologin app

COPY --from=builder /app/target/release/market-data-worker /usr/local/bin/market-data-worker

USER 10005
EXPOSE 8094
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8094/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/market-data-worker"]
