{
  "name": "crypto-pocket-butler-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit && node scripts/check-size.mjs"
  },
  "size-limit": [
    {
      "name": "initial entry chunk",
      "path": "dist/assets/index-*.js",
      "limit": "300 kB",
      "gzip": true
    },
    {
      "name": "route chunk",
      "path": "dist/assets/route-*.js",
      "limit": "150 kB",
      "gzip": true
    },
    {
      "name": "initial stylesheet",
      "path": "dist/assets/*.css",
      "limit": "150 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.11",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-app": "^14.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-is": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
